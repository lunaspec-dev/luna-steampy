# This is where you should place your Steam API key and personal Steam ID.
# Make sure to rename this file to `.env` and keep it secure. Do not share your API key or Steam ID publicly EVER.

# put .env in your .gitignore file as well to avoid accidentally committing it to version control!
# cd steam_api_explorer/auth
# echo .env >> .gitignore

STEAM_API_KEY=YOURKEYHERE
PERSONAL_STEAM_ID=YOUR_STEAM_ID_HERE